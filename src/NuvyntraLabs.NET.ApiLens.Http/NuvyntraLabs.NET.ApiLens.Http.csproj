<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NuvyntraLabs.NET.ApiLens.Http</RootNamespace>
    <Description>Outbound HttpClient timings for ApiLens from System.Net.Http diagnostic events. Query strings and bodies are not stored.</Description>
    <PackageTags>httpclient;diagnostics;apilens;nuvyntra</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.1" />
    <ProjectReference Include="..\NuvyntraLabs.NET.ApiLens\NuvyntraLabs.NET.ApiLens.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
